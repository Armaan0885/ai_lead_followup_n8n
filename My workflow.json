    {
      "parameters": {
        "jsCode": "const parts = $input.first().json.content.parts;\nconst raw = (parts.find(p => p.text) || {}).text || '';\nconst clean = raw.replace(/```json|```/g, '').trim();\n\nlet data;\ntry {\n  data = JSON.parse(clean);\n} catch (e) {\n  data = {\n    score: 'unknown',\n    reason: 'Could not parse model output',\n    email_subject: '',\n    email_body: ''\n  };\n}\n\nconst lead = $('On form submission').first().json;\n\nreturn [{\n  json: {\n    name: lead.Name,\n    email: lead.Email,\n    company: lead.Company,\n    message: lead.Message,\n    ...data\n  }\n}];"
      },
